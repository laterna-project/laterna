# Binaries and build output
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# Local development data (never committed)
/.dev/
.env
laterna.toml

# Test media generated by `task fixtures`
/testdata/library/

# Editors
.idea/
.vscode/
*.swp

# FFmpeg builds downloaded for the release bundles
/packaging/ffmpeg/

# A Compose deployment's own settings and credentials (deploy/compose/README.md)
/deploy/compose/*.env
/deploy/compose/root.crt
/deploy/compose/local.yaml
!/deploy/compose/config/laterna.toml
