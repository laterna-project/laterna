# Values for test.sh: every variable a module requires, none of them real.
LATERNA_VERSION=0.9
LATERNA_PORT=18096
HTTPS_PORT=18443
TZ=Etc/UTC
MEDIA_DIR=./empty
MOVIES_DIR=./empty
SHOWS_DIR=./empty
MUSIC_DIR=./empty
BOOKS_DIR=./empty
PHOTOS_DIR=./empty
NFS_SERVER=nas.invalid
NFS_PATH=/media
SMB_SHARE=//nas.invalid/media
SMB_USER=laterna
SMB_PASSWORD=test
BACKUP_DIR=./test/backups
CONFIG_DIR=./test/config
CACHE_DIR=./test/cache
RENDER_GID=109
LATERNA_HOST=laterna.test
ACME_EMAIL=admin@laterna.test
DNS_PROVIDER=duckdns
DUCKDNS_SUBDOMAIN=laterna-test
TRAEFIK_DNS_PROVIDER=duckdns
# Traefik never reaches a real certificate authority in the tests: it serves its default
# certificate.
ACME_CA_SERVER=http://127.0.0.1:9/directory
EXTERNAL_NETWORK=laterna-test-external
CERT_DIR=./test/certs
SWAG_DOMAIN=laterna.test
SWAG_DNS_PLUGIN=cloudflare
CLOUDFLARE_TUNNEL_TOKEN=test
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
GRAFANA_PASSWORD=compose-test
JAEGER_PORT=26686
UPTIME_KUMA_PORT=13001
JELLYFIN_DIR=./test/jellyfin
BACKUP_DIR_OFFSITE=./test/offsite
