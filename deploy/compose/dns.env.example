# Copy to dns.env (never commit it) and keep only the lines of your DNS provider, the one set in
# DNS_PROVIDER in .env. The token only needs to edit the DNS records of the domain: create it
# with the narrowest rights the provider offers.

# --- duckdns: https://www.duckdns.org (token at the top of the page) ------------------------
DUCKDNS_TOKEN=

# --- cloudflare: API token with Zone / DNS / Edit on the zone ------------------------------
# CLOUDFLARE_API_TOKEN=

# --- ovh: https://api.ovh.com/createToken/ with GET/POST/DELETE on /domain/zone/* ----------
# OVH_ENDPOINT=ovh-eu
# OVH_APPLICATION_KEY=
# OVH_APPLICATION_SECRET=
# OVH_CONSUMER_KEY=

# --- gandi: personal access token with "Manage domain technical configurations" ------------
# GANDI_BEARER_TOKEN=

# --- porkbun: API access turned on for the domain ------------------------------------------
# PORKBUN_API_KEY=
# PORKBUN_API_SECRET_KEY=

# --- namecheap: API access, with this machine's public address allowed ---------------------
# NAMECHEAP_API_KEY=
# NAMECHEAP_API_USER=

# --- desec: https://desec.io token ----------------------------------------------------------
# DESEC_TOKEN=

# --- hetzner: DNS console API token ---------------------------------------------------------
# HETZNER_API_TOKEN=

# --- digitalocean: personal access token with domain read and write ------------------------
# DIGITALOCEAN_API_TOKEN=

# --- route53: IAM user allowed route53:ChangeResourceRecordSets and ListHostedZones --------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --- ionos: API key as "prefix.secret" ------------------------------------------------------
# IONOS_API_TOKEN=

# --- infomaniak: API token with the "domain" scope -----------------------------------------
# INFOMANIAK_API_TOKEN=

# --- godaddy: production API key as "key:secret" --------------------------------------------
# GODADDY_API_TOKEN=

# --- netcup: customer number, API key and API password (DNS changes are slow there) --------
# NETCUP_CUSTOMER_NUMBER=
# NETCUP_API_KEY=
# NETCUP_API_PASSWORD=

# --- scaleway: API key of a project allowed to edit DNS -------------------------------------
# SCW_SECRET_KEY=
# SCW_ORGANIZATION_ID=

# --- linode: personal access token with Domains read/write ---------------------------------
# LINODE_PERSONAL_ACCESS_TOKEN=

# --- dnsimple: account API access token ----------------------------------------------------
# DNSIMPLE_API_ACCESS_TOKEN=

# --- bunny: API key of the account ---------------------------------------------------------
# BUNNY_API_KEY=


# --- azure: service principal with "DNS Zone Contributor" on the zone ----------------------
# AZURE_SUBSCRIPTION_ID=
# AZURE_RESOURCE_GROUP_NAME=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
