# Laterna behind nginx (modules/nginx.yaml). Also a model for an nginx installed elsewhere: change
# the certificate paths and ${LATERNA_UPSTREAM}.
server {
    listen 443 ssl;
    http2 on;
    server_name ${LATERNA_HOST};

    ssl_certificate /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # Theme files, the biggest requests, go up to 32 MB.
    client_max_body_size 32m;

    location / {
        proxy_pass http://${LATERNA_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Video segments and the event stream go out as they come, and a segment that a slow
        # transcode takes long to produce is still waited for.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
