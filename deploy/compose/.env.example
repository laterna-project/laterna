# Copy to .env, then fill in what the chosen modules need. README.md describes every module; the
# variables of a module are only read with that module.

# Modules: the base, then the modules wanted, separated by ":" (";" on Windows). For instance
# COMPOSE_FILE=compose.yaml:modules/intel-gpu.yaml:modules/https-dns.yaml:modules/duckdns-updater.yaml
COMPOSE_FILE=compose.yaml

# --- Base -----------------------------------------------------------------------------------
# Image tag: 0.6 follows the patches of 0.6.x, latest every release, 0.6.0 one version.
LATERNA_VERSION=0.6
LATERNA_PORT=8096
TZ=Etc/UTC
# The folder holding the media, mounted read-only at /media. Leave it out with media-split,
# media-nfs or media-smb.
MEDIA_DIR=/srv/media

# --- media-split: one folder per kind, unset ones stay empty ---------------------------------
# MOVIES_DIR=/mnt/disk1/movies
# SHOWS_DIR=/mnt/disk2/shows
# MUSIC_DIR=
# BOOKS_DIR=
# PHOTOS_DIR=

# --- media-nfs ------------------------------------------------------------------------------
# NFS_SERVER=nas.local
# NFS_PATH=/volume1/media
# NFS_VERSION=4

# --- media-smb ------------------------------------------------------------------------------
# SMB_SHARE=//nas.local/media
# SMB_USER=laterna
# SMB_PASSWORD=
# SMB_VERSION=3.0

# --- backups --------------------------------------------------------------------------------
# BACKUP_DIR=/mnt/other-disk/laterna-backups

# --- custom-user ----------------------------------------------------------------------------
# PUID=1000
# PGID=1000
# CONFIG_DIR=/srv/laterna/config
# CACHE_DIR=/srv/laterna/cache

# --- intel-gpu: getent group render | cut -d: -f3 ------------------------------------------
# RENDER_GID=

# --- resources ------------------------------------------------------------------------------
# LATERNA_CPUS=4
# LATERNA_MEMORY=2g

# --- external-network -----------------------------------------------------------------------
# EXTERNAL_NETWORK=proxy

# --- Every HTTPS module ---------------------------------------------------------------------
# The address of the server, a name of your domain (https-dns, https-public, traefik, nginx...).
# LATERNA_HOST=laterna.example.com
# HTTPS_PORT=443
# Addresses Laterna takes X-Forwarded-For from: the proxy's network (README.md).
# TRUSTED_PROXIES=172.16.0.0/12
# Where the proxy finds Laterna: host.docker.internal:8096 with host-network or a server
# installed without Docker.
# LATERNA_UPSTREAM=laterna:8096

# --- https-dns: the provider's credentials go in dns.env ------------------------------------
# DNS_PROVIDER=duckdns

# --- duckdns-updater ------------------------------------------------------------------------
# DUCKDNS_SUBDOMAIN=my-laterna
# This machine's address on the local network; required under Docker Desktop.
# LOCAL_IP=

# --- https-public ---------------------------------------------------------------------------
# ACME_EMAIL=you@example.com

# --- traefik: the provider's credentials go in traefik-dns.env ------------------------------
# TRAEFIK_DNS_PROVIDER=duckdns
# ACME_CA_SERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# --- traefik-labels -------------------------------------------------------------------------
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt

# --- nginx: folder with fullchain.pem and privkey.pem ---------------------------------------
# CERT_DIR=/etc/letsencrypt/live/laterna.example.com

# --- npm ------------------------------------------------------------------------------------
# NPM_ADMIN_PORT=81

# --- swag: credentials in the swag-config volume, dns-conf/<plugin>.ini ---------------------
# SWAG_DOMAIN=example.com
# SWAG_DNS_PLUGIN=cloudflare

# --- tailscale ------------------------------------------------------------------------------
# TS_AUTHKEY=
# TS_HOSTNAME=laterna
# TAILSCALE_SERVE=serve

# --- cloudflared ----------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=

# --- prometheus -----------------------------------------------------------------------------
# The token Laterna shows once (Administration, Observability).
# LATERNA_METRICS_TOKEN=
# GRAFANA_PASSWORD=
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090
# PROMETHEUS_RETENTION=90d

# --- jaeger ---------------------------------------------------------------------------------
# JAEGER_PORT=16686

# --- uptime-kuma ----------------------------------------------------------------------------
# UPTIME_KUMA_PORT=3001

# --- jellyfin-import: Jellyfin's data folder, the one with data/jellyfin.db -----------------
# JELLYFIN_DIR=/srv/jellyfin/config

# --- Single sign-on: every provider module ------------------------------------------------
# AUTH_HOST=auth.example.com
# openssl rand -hex 32
# OIDC_CLIENT_SECRET=
# With HTTPS_PORT other than 443: https://<host>:<port> for each.
# LATERNA_URL=https://laterna.example.com
# AUTH_URL=https://auth.example.com

# --- authelia -------------------------------------------------------------------------------
# AUTHELIA_USER=me
# AUTHELIA_PASSWORD=
# AUTHELIA_EMAIL=me@example.com
# AUTHELIA_POLICY=one_factor

# --- authentik: openssl rand -hex 40 and -hex 16, kept forever ------------------------------
# AUTHENTIK_SECRET_KEY=
# AUTHENTIK_DB_PASSWORD=
# AUTHENTIK_PASSWORD=
# AUTHENTIK_EMAIL=me@example.com

# --- keycloak -------------------------------------------------------------------------------
# KEYCLOAK_DB_PASSWORD=
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=

# --- pocket-id: openssl rand -base64 32, kept forever ---------------------------------------
# POCKET_ID_ENCRYPTION_KEY=

# --- diun: notifications in diun.env --------------------------------------------------------
# DIUN_SCHEDULE=0 */6 * * *

# --- watchtower: notifications in watchtower.env -------------------------------------------
# WATCHTOWER_SCHEDULE=0 0 4 * * *

# --- backup-offsite: remote destinations in backup-offsite.env ------------------------------
# BACKUP_DIR_OFFSITE=/mnt/other-disk/laterna-archives
# BACKUP_SCHEDULE=30 3 * * *
# BACKUP_RETENTION_DAYS=14
